#!/usr/bin/env bash
# Stop everything nerd runs: the agent <name>, the server <name>-llm (or,
# with NERD_LLAMA=host or mlx, the server on this machine: tools/llama-host.sh
# stop or tools/mlx-host.sh stop), and their network <name>-net. The GPU and
# memory are free after it.
# Volumes are kept, so ./UP continues with the same workspace, conversation,
# ssh host key, home (installed languages, memory), caches and model.
#
#   ./DOWN                  stop and remove the containers, stop the server
#   ./DOWN --agent          only the agent (the model stays loaded; ./UP brings it back)
#   ./DOWN --purge          also delete the volumes: workspace, logs and
#                           conversations, ssh host keys, home, caches (NOT the model)
#   ./DOWN --purge-models   --purge, and the model volume too (6-7 GB to download again)
set -euo pipefail
# shellcheck source=tools/lib.sh
. "$(dirname "$0")/tools/lib.sh"

purge=0 models=0 agent_only=0
for a in "$@"; do
  case "$a" in
    --agent) agent_only=1 ;;
    --purge) purge=1 ;;
    --purge-models) purge=1 models=1 ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) echo "DOWN: unknown argument '$a' (--agent, --purge, --purge-models)" >&2; exit 2 ;;
  esac
done
[ "$agent_only" = 1 ] && [ "$purge" = 1 ] && { echo "DOWN: --agent and --purge do not go together" >&2; exit 2; }

nerd_load_env
nerd_settings
nerd_compose_env
# compose.yaml needs a key to resolve; stopping does not.
export NERD_AUTHORIZED_KEYS=${NERD_AUTHORIZED_KEYS:-none}

# A container compose did not start (./UP before decision 0012) is stopped
# by name, as ./DOWN did then.
down_plain() {
  if docker container inspect "$1" >/dev/null 2>&1; then
    docker stop -t 30 "$1" >/dev/null
    docker rm "$1" >/dev/null
    echo "[DOWN] container $1 stopped and removed"
  fi
}
ours() { [ "$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$1" 2>/dev/null)" = "$NERD_NAME" ]; }

if [ "$agent_only" = 1 ]; then
  if ours "$NERD_NAME"; then nerd_compose rm -s -f agent; else down_plain "$NERD_NAME"; fi
  exit 0
fi
for c in "$NERD_NAME" "$NERD_LLM_NAME"; do ours "$c" || down_plain "$c"; done
nerd_compose down --timeout 30
if nerd_on_host; then
  # ./UP started it, so ./DOWN stops it: whoever runs ./DOWN expects the GPU
  # and memory back. Only the server the host script started (its pid file).
  "$(nerd_host_tool)" stop
fi
if [ -z "${NERD_NETWORK:-}" ] && docker network inspect "$NERD_NAME-net" >/dev/null 2>&1; then
  docker network rm "$NERD_NAME-net" >/dev/null && echo "[DOWN] network $NERD_NAME-net removed"
fi

if [ "$purge" = 1 ]; then
  read -r -a vols <<< "$(nerd_volumes)"
  [ "$models" = 1 ] && vols+=("$NERD_MODELS_VOLUME")
  for v in "${vols[@]}"; do
    if docker volume inspect "$v" >/dev/null 2>&1; then
      docker volume rm "$v" >/dev/null && echo "[DOWN] volume $v deleted"
    fi
  done
  [ -n "${NERD_WORKSPACE:-}" ] && echo "[DOWN] the workspace directory $NERD_WORKSPACE is a host directory and was left alone"
fi
exit 0
