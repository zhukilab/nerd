#!/usr/bin/env bash
# Stop and remove the nerd container. Volumes are kept, so ./UP continues with
# the same workspace, conversation, ssh host key and model.
#
#   ./DOWN                  stop and remove the container
#   ./DOWN --purge          also delete its volumes: workspace, logs and
#                           conversations, ssh host keys (NOT the model)
#   ./DOWN --purge-models   --purge, and the model volume too (6-7 GB to download again)
set -euo pipefail
# shellcheck source=tools/lib.sh
. "$(dirname "$0")/tools/lib.sh"

purge=0 models=0
for a in "$@"; do
  case "$a" in
    --purge) purge=1 ;;
    --purge-models) purge=1 models=1 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) echo "DOWN: unknown argument '$a' (--purge, --purge-models)" >&2; exit 2 ;;
  esac
done

nerd_load_env
nerd_settings

if docker container inspect "$NERD_NAME" >/dev/null 2>&1; then
  docker stop -t 30 "$NERD_NAME" >/dev/null
  docker rm "$NERD_NAME" >/dev/null
  echo "[DOWN] container $NERD_NAME stopped and removed"
else
  echo "[DOWN] no container $NERD_NAME"
fi

if [ "$purge" = 1 ]; then
  vols=("$NERD_NAME-ws" "$NERD_NAME-ssh" "$NERD_NAME-logs")
  [ "$models" = 1 ] && vols+=("$NERD_MODELS_VOLUME")
  for v in "${vols[@]}"; do
    if docker volume inspect "$v" >/dev/null 2>&1; then
      docker volume rm "$v" >/dev/null && echo "[DOWN] volume $v deleted"
    fi
  done
  [ -n "${NERD_WORKSPACE:-}" ] && echo "[DOWN] the workspace directory $NERD_WORKSPACE is a host directory and was left alone"
fi
exit 0
