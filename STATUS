#!/usr/bin/env bash
# Is nerd up? The server (container <name>-llm, or on the host with
# NERD_LLAMA=host), the agent's container, llama-server as the agent reaches
# it, sshd and the app port. Exit 0 when both run, the model is served and ssh
# answers.
set -uo pipefail
# shellcheck source=tools/lib.sh
. "$(dirname "$0")/tools/lib.sh"
nerd_load_env
nerd_settings

bad=0
row() { printf '%-8s %-14s %s\n' "$1" "$2" "$3"; [ "$1" = OK ] || [ "$1" = INFO ] || bad=1; }
cstate() { docker inspect -f '{{.State.Status}} since {{.State.StartedAt}}, restarts {{.RestartCount}}, image {{.Config.Image}}' "$1" 2>/dev/null; }

# --- the server ---------------------------------------------------------------------
if [ "$NERD_LLAMA" = host ]; then
  if nerd_host_llama_up; then row OK server "llama-server on this machine, 127.0.0.1:$NERD_LLAMA_PORT (tools/llama-host.sh)"
  else row DOWN server "no llama-server on this machine: ./UP starts it"; fi
else
  s=$(cstate "$NERD_LLM_NAME")
  case "$s" in
    running*) row OK server "$NERD_LLM_NAME $s" ;;
    "") row DOWN server "no container $NERD_LLM_NAME (./UP starts it)" ;;
    *) row DOWN server "$NERD_LLM_NAME $s (docker logs --tail 30 $NERD_LLM_NAME)" ;;
  esac
fi

# --- the agent ----------------------------------------------------------------------
state=$(cstate "$NERD_NAME")
if [ -z "$state" ]; then
  row DOWN container "no container $NERD_NAME (./UP starts it)"
  exit 1
fi
case "$state" in
  running*) row OK container "$NERD_NAME $state" ;;
  *) row DOWN container "$NERD_NAME $state"; exit 1 ;;
esac

# From inside the agent's container: the server as the agent reaches it, and
# sshd/app the same with published ports and with --network container:.
inside() { docker exec "$NERD_NAME" "$@" 2>/dev/null; }
base=$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$NERD_NAME" 2>/dev/null | sed -n 's/^NERD_BASE_URL=//p')
base=${base:-$NERD_LLAMA_URL}
if inside curl -sf -m 3 "${base%/v1}/health" >/dev/null; then
  model=$(inside curl -sf -m 3 "$base/models" | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)
  row OK llama "$base answers the agent, model ${model:-?}"
elif [ "$NERD_LLAMA" = host ] && nerd_host_llama_up; then
  row DOWN llama "answers on the host's 127.0.0.1:$NERD_LLAMA_PORT, but not from the container at $base (docs/MACOS.md, troubleshooting)"
elif [ "$NERD_LLAMA" = container ] && docker logs "$NERD_LLM_NAME" 2>&1 | tr '\r' '\n' | grep -q 'downloading'; then
  row WAIT llama "not serving yet; the model is downloading or loading (docker logs -f $NERD_LLM_NAME)"
elif [ "$NERD_LLAMA" = host ]; then
  row WAIT llama "$base does not answer yet (tools/llama-host.sh logs)"
else
  row WAIT llama "$base does not answer yet (docker logs --tail 30 $NERD_LLM_NAME)"
fi

if inside timeout 3 bash -c "exec 3<>/dev/tcp/127.0.0.1/$NERD_SSH_PORT; head -c 7 <&3" | grep -q '^SSH-2'; then
  row OK ssh "sshd answers on :$NERD_SSH_PORT"
else
  row DOWN ssh "sshd does not answer on :$NERD_SSH_PORT"
fi
if inside tmux has-session -t nerd; then
  row OK agent "Pi runs in tmux session 'nerd'"
else
  row WAIT agent "no tmux session yet (starts once the model is served)"
fi

if inside timeout 3 bash -c "exec 3<>/dev/tcp/127.0.0.1/$NERD_APP_PORT"; then
  row INFO app "something listens on :$NERD_APP_PORT (what the agent built)"
else
  row INFO app "nothing on :$NERD_APP_PORT yet (the agent serves there when it builds a web app)"
fi

pub=$(docker port "$NERD_NAME" 2>/dev/null | tr '\n' ' ')
row INFO published "${pub:-none (network ${NERD_NETWORK:-?})}"
exit "$bad"
