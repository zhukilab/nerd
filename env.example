# Settings for ./UP, ./DOWN, ./STATUS and tools/check-prerequisites.sh.
# Copy to .env (git-ignored) and edit:  cp env.example .env
# Every line is optional; an empty value means "use the default shown".
# For a name set twice the last line wins, so `echo NERD_LLAMA=mlx >> .env`
# after the copy works; editing the line that is here keeps the file readable.
# ./UP reads this file itself and hands the result to docker compose
# (compose.yaml); compose does not read .env.

# Name of the agent's container and of the compose project. The server's is
# <name>-llm, their network <name>-net, the volumes <name>-ws (workspace),
# <name>-logs (logs and conversations), <name>-ssh (ssh host keys),
# <name>-home (the agent's home: languages it installed, memory) and
# <name>-cache (caches, safe to throw away).
NERD_NAME=nerd

# Image tags; ./UP builds them if missing. Empty: nerd:agent for the agent,
# nerd:server-sm<CUDA_ARCH> (e.g. nerd:server-sm86) for the server.
NERD_IMAGE=
NERD_SERVER_IMAGE=

# The server's GPU build arguments. Empty: detected from nvidia-smi (compute capability).
# CUDA_ARCH is the compute capability without the dot (86 = RTX 30xx, 89 = RTX
# 40xx, 121 = GB10). CUDA_VERSION defaults to 12.4.1, or 13.0.1 for compute
# capability 10.0 and up; the host driver must support it.
NERD_CUDA_ARCH=
NERD_CUDA_VERSION=

# How the GPU is passed: auto (a CDI spec if one exists, else --gpus all), cdi, gpus.
NERD_GPU=auto

# Where the model server runs: auto, container (llama-server in its own
# container <name>-llm, with the GPU), host (llama-server on this machine,
# started by tools/llama-host.sh; only the agent's image is built) or mlx
# (a Mac with Apple silicon: mlx-vlm's server, the model in MLX format,
# tools/mlx-host.sh). auto = host on macOS (docs/MACOS.md), container elsewhere.
# Neither Mac path has been run on a real Mac yet.
NERD_LLAMA=auto
# The server as the agent's container reaches it. Empty: http://<name>-llm:<port>/v1,
# http://127.0.0.1:<port>/v1 with NERD_NETWORK, http://host.docker.internal:<port>/v1
# with NERD_LLAMA=host or mlx.
NERD_LLAMA_URL=
# NERD_LLAMA=host or mlx only: the address the server binds (empty:
# 127.0.0.1), and the directory for its source or venv, model and log (empty: ~/.nerd).
NERD_LLAMA_HOST=
NERD_HOST_DIR=

# Model variant: q1 (5.95 GB, fits 8 GB VRAM at 64K) or q2 (7.21 GB, 12 GB and up).
NERD_MODEL_VARIANT=q1
# Another GGUF for llama-server instead of the variant: hf:<owner>/<repo>/<file>.gguf
# (optionally @<revision>; downloaded once, its sha256 checked against what
# Hugging Face publishes, or against NERD_MODEL_SHA256), or the name of a .gguf
# already in the models volume (NERD_LLAMA=host: in ~/.nerd/models). The model is
# then called NERD_MODEL_ALIAS, by default the file's name without .gguf.
# It must be one this llama.cpp fork runs (Bonsai's, or any ordinary GGUF).
NERD_MODEL_GGUF=
NERD_MODEL_SHA256=
NERD_MODEL_ALIAS=
# NERD_LLAMA=mlx only: the model, <owner>/<repo>[@<revision>] on Hugging Face or a
# directory (empty: Bonsai 2 27B in MLX 2-bit at a pinned revision), and the
# python3.12/3.13 for its venv (empty: the first found). NERD_MLX_APC=0 turns
# off the server's prefix cache (then every turn computes the whole prompt again).
NERD_MLX_MODEL=
NERD_MLX_PYTHON=
NERD_MLX_APC=
# Sampling fields added to every request that does not set them, e.g.
# temperature=0.7,top_p=0.8,top_k=20. Empty: the server's own defaults; with
# NERD_LLAMA=mlx (whose server would decode greedily), the model card's
# temperature=0.7,top_p=0.8,top_k=20,presence_penalty=1.5.
NERD_SAMPLING=
# Context window in tokens. 65536 is the default; 32768 if 64K does not fit.
NERD_CTX=65536

# Ports. The same number is used inside the container and on the host.
NERD_SSH_PORT=2222        # ssh into the agent's terminal
NERD_APP_PORT=8000        # what the agent builds is served here
NERD_LLAMA_PORT=8080      # llama-server: on <name>-net (not published), or on the host (NERD_LLAMA=host or mlx)
# Host address the ports are published on: 0.0.0.0 (all) or 127.0.0.1 (this machine only).
NERD_BIND=0.0.0.0

# Public key(s) allowed to log in, one file. Empty: the first of
# ~/.ssh/id_ed25519.pub, ~/.ssh/id_ecdsa.pub, ~/.ssh/id_rsa.pub.
NERD_AUTHORIZED_KEYS_FILE=

# The address at which you open what the agent builds, as you type it in your
# browser (e.g. http://my-gpu-box:8000). The agent is told it as a fact and
# names it when it reports. Empty: the agent is told only the port.
NERD_OPERATOR_URL=

# Where the agent works. Empty: a docker volume <name>-ws. A host directory
# must be writable by uid 1000 (the agent container's user).
NERD_WORKSPACE=

# Docker volume with the model (shared by every nerd server on the machine).
NERD_MODELS_VOLUME=nerd-models

# Optional: both containers join another container's network namespace instead
# of <name>-net and publishing ports (e.g. a VPN sidecar): container:<its name>.
# Ports are then not published; the server listens on loopback only.
NERD_NETWORK=

# Size of /tmp, a tmpfs (memory) in both containers. A big build belongs in
# the workspace, not in /tmp.
NERD_TMP_SIZE=2g
# Size of the agent's /dev/shm (its headless browser needs more than docker's 64m).
NERD_SHM_SIZE=1g

# Anything else for the containers (an agent variable such as NERD_VERIFY_N, a
# proxy for the server) goes into compose.override.yaml next to compose.yaml
# (git-ignored), which ./UP adds when it exists; docs/OPERATE.md has an example.
# NERD_DOCKER_ARGS and NERD_SERVER_DOCKER_ARGS are gone with decision 0012.
