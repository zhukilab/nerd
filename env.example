# Settings for ./UP, ./DOWN, ./STATUS and tools/check-prerequisites.sh.
# Copy to .env (git-ignored) and edit:  cp env.example .env
# Every line is optional; an empty value means "use the default shown".

# Container name. Volumes are named after it: <name>-ws, <name>-ssh, <name>-logs.
NERD_NAME=nerd

# Image tag. Empty: nerd:sm<CUDA_ARCH>, e.g. nerd:sm86. ./UP builds it if missing.
NERD_IMAGE=

# GPU build arguments. Empty: detected from nvidia-smi (compute capability).
# CUDA_ARCH is the compute capability without the dot (86 = RTX 30xx, 89 = RTX
# 40xx, 121 = GB10). CUDA_VERSION defaults to 12.4.1, or 13.0.1 for compute
# capability 10.0 and up; the host driver must support it.
NERD_CUDA_ARCH=
NERD_CUDA_VERSION=

# How the GPU is passed: auto (a CDI spec if one exists, else --gpus all), cdi, gpus.
NERD_GPU=auto

# Model variant: q1 (5.95 GB, fits 8 GB VRAM at 64K) or q2 (7.21 GB, 12 GB and up).
NERD_MODEL_VARIANT=q1
# Context window in tokens. 65536 is the default; 32768 if 64K does not fit.
NERD_CTX=65536

# Ports. The same number is used inside the container and on the host.
NERD_SSH_PORT=2222        # ssh into the agent's terminal
NERD_APP_PORT=8000        # what the agent builds is served here
NERD_LLAMA_PORT=8080      # llama-server, inside the container only
# Host address the ports are published on: 0.0.0.0 (all) or 127.0.0.1 (this machine only).
NERD_BIND=0.0.0.0

# Public key(s) allowed to log in, one file. Empty: the first of
# ~/.ssh/id_ed25519.pub, ~/.ssh/id_ecdsa.pub, ~/.ssh/id_rsa.pub.
NERD_AUTHORIZED_KEYS_FILE=

# The address at which you open what the agent builds, as you type it in your
# browser (e.g. http://my-gpu-box:8000). The agent is told it as a fact and
# names it when it reports. Empty: the agent is told only the port.
NERD_OPERATOR_URL=

# Where the agent works. Empty: a docker volume <name>-ws. A host directory
# must be writable by uid 1000 (the container's user).
NERD_WORKSPACE=

# Docker volume with the model (shared by every nerd container on the machine).
NERD_MODELS_VOLUME=nerd-models

# Optional: join another container's network namespace instead of publishing
# ports (e.g. a VPN sidecar): container:<its name>. Ports are then not published.
NERD_NETWORK=

# Anything else for `docker run`, word-split, e.g. "-e NERD_VERIFY_N=2 -e HF_TOKEN=...".
NERD_DOCKER_ARGS=
