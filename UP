#!/usr/bin/env bash
# Start nerd: build the images if they are missing, start the model server
# (container <name>-llm, or on this machine with NERD_LLAMA=host) and the
# agent (container <name>, tui mode), both with a restart policy; wait until
# the model is served and the agent is up; print how to connect.
# Settings: .env (see env.example). Docs: docs/OPERATE.md.
#
#   ./UP              build if needed, start, wait for the model
#   ./UP --build      rebuild the images first (after git pull)
#   ./UP --no-wait    start and return; ./STATUS tells when it is ready
#   ./UP --dry-run    print the docker commands, run nothing
#
# The server container is kept when it runs with the same image and settings,
# so ./UP after a change to the agent does not reload the model.
set -euo pipefail
# shellcheck source=tools/lib.sh
. "$(dirname "$0")/tools/lib.sh"

build=0 wait=1 dry=0
for a in "$@"; do
  case "$a" in
    --build) build=1 ;;
    --no-wait) wait=0 ;;
    --dry-run) dry=1 ;;
    -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
    *) echo "UP: unknown argument '$a' (--build, --no-wait, --dry-run)" >&2; exit 2 ;;
  esac
done

nerd_load_env
nerd_settings
say() { echo "[UP] $*"; }
die() { echo "[UP] ERROR: $*" >&2; exit 1; }
run() { if [ "$dry" = 1 ]; then { printf '+'; printf ' %q' "$@"; echo; } >&2; else "$@"; fi; }

command -v docker >/dev/null || die "docker not found: tools/install-prerequisites.sh"
docker info >/dev/null 2>&1 || die "docker is not usable by $(id -un) (daemon down, or not in group docker): tools/check-prerequisites.sh"

keys=$(nerd_keys_file) || die "no ssh public key: set NERD_AUTHORIZED_KEYS_FILE in .env, or ssh-keygen -t ed25519"
[ -s "$keys" ] || die "public key file '$keys' is missing or empty"
grep -q '^\(ssh-\|ecdsa-\|sk-\)' "$keys" || die "'$keys' does not look like a public key (ssh-ed25519 ...)"

case "$NERD_MODEL_VARIANT" in q1|q2) ;; *) die "NERD_MODEL_VARIANT must be q1 or q2" ;; esac
case "$NERD_LLAMA" in container|host) ;; *) die "NERD_LLAMA must be auto, container or host" ;; esac

# llama-server on the host (macOS): it must be up before the agent starts.
if [ "$NERD_LLAMA" = host ] && [ "$dry" = 0 ] && ! nerd_host_llama_up; then
  die "NERD_LLAMA=host, but no llama-server answers on 127.0.0.1:$NERD_LLAMA_PORT: tools/llama-host.sh start (docs/MACOS.md)"
fi

# --- images ----------------------------------------------------------------------
if [ "$build" = 1 ] || ! docker image inspect "$NERD_IMAGE" >/dev/null 2>&1; then
  say "building the agent image $NERD_IMAGE ($(uname -m)); first build: 5-10 min"
  run docker build -t "$NERD_IMAGE" --target agent "$NERD_ROOT"
fi
if [ "$NERD_LLAMA" = container ] && { [ "$build" = 1 ] || ! docker image inspect "$NERD_SERVER_IMAGE" >/dev/null 2>&1; }; then
  say "building the server image $NERD_SERVER_IMAGE (CUDA_ARCH=$NERD_CUDA_ARCH, CUDA_VERSION=$NERD_CUDA_VERSION); first build: 5-15 min plus the CUDA base image download"
  run docker build -t "$NERD_SERVER_IMAGE" --target server \
    --build-arg "CUDA_ARCH=$NERD_CUDA_ARCH" --build-arg "CUDA_VERSION=$NERD_CUDA_VERSION" "$NERD_ROOT"
fi

# --- network -----------------------------------------------------------------------
# Both containers on <name>-net, where the agent finds the server by name; or
# both in NERD_NETWORK's namespace (container:<name>), on loopback there.
if [ -n "${NERD_NETWORK:-}" ]; then
  net=$NERD_NETWORK
else
  net=$NERD_NAME-net
  docker network inspect "$net" >/dev/null 2>&1 || run docker network create "$net" >/dev/null
fi

# --- the server -----------------------------------------------------------------------
if [ "$NERD_LLAMA" = container ]; then
  read -r -a gpu <<< "$(nerd_gpu_args)"
  # Loopback in a shared namespace (NERD_NETWORK may be a VPN sidecar: the
  # server must not answer there), all addresses of its own network otherwise
  # (no port is published).
  if [ -n "${NERD_NETWORK:-}" ]; then shost=127.0.0.1; else shost=0.0.0.0; fi
  img_id=$(docker image inspect -f '{{.Id}}' "$NERD_SERVER_IMAGE" 2>/dev/null || echo "$NERD_SERVER_IMAGE")
  config="$img_id $NERD_MODEL_VARIANT $NERD_CTX $NERD_LLAMA_PORT $shost $net ${gpu[*]} ${HF_TOKEN:+hf} ${NERD_SERVER_DOCKER_ARGS:-}"
  have=$(docker inspect -f '{{.State.Status}} {{index .Config.Labels "nerd.config"}}' "$NERD_LLM_NAME" 2>/dev/null || true)
  if [ "$have" = "running $config" ]; then
    say "server $NERD_LLM_NAME runs with the same image and settings: kept (the model stays loaded)"
  else
    if [ -n "$have" ]; then
      say "replacing the server container $NERD_LLM_NAME (the model volume is kept)"
      run docker rm -f "$NERD_LLM_NAME" >/dev/null
    fi
    sargs=(-d --name "$NERD_LLM_NAME" --restart unless-stopped "${gpu[@]}" --network "$net"
      --label "nerd.config=$config"
      -e "NERD_MODEL_VARIANT=$NERD_MODEL_VARIANT" -e "NERD_CTX=$NERD_CTX"
      -e "NERD_LLAMA_PORT=$NERD_LLAMA_PORT" -e "NERD_HOST=$shost"
      -v "$NERD_MODELS_VOLUME:/models")
    [ -n "${HF_TOKEN:-}" ] && sargs+=(-e "HF_TOKEN=$HF_TOKEN")
    if [ -n "${NERD_SERVER_DOCKER_ARGS:-}" ]; then
      read -r -a sextra <<< "$NERD_SERVER_DOCKER_ARGS"
      sargs+=("${sextra[@]}")
    fi
    say "starting the server $NERD_LLM_NAME from $NERD_SERVER_IMAGE ($NERD_MODEL_VARIANT, context $NERD_CTX, GPU: ${gpu[*]})"
    run docker run "${sargs[@]}" "$NERD_SERVER_IMAGE" serve >/dev/null
  fi
fi

# --- the agent ------------------------------------------------------------------------
if docker container inspect "$NERD_NAME" >/dev/null 2>&1; then
  say "replacing the agent container $NERD_NAME (volumes kept)"
  run docker rm -f "$NERD_NAME" >/dev/null
fi
args=(-d --name "$NERD_NAME" --restart unless-stopped --network "$net"
  -e "NERD_BASE_URL=$NERD_LLAMA_URL"
  -e "NERD_SSH_PORT=$NERD_SSH_PORT" -e "NERD_APP_PORT=$NERD_APP_PORT"
  -e "NERD_AUTHORIZED_KEYS=$(cat "$keys")"
  -v "$NERD_NAME-ssh:/ssh" -v "$NERD_NAME-logs:/logs")
# host-gateway: Docker Desktop resolves host.docker.internal itself, Linux
# needs the mapping.
[ "$NERD_LLAMA" = host ] && args+=(--add-host host.docker.internal:host-gateway)
[ -n "${NERD_OPERATOR_URL:-}" ] && args+=(-e "NERD_OPERATOR_URL=$NERD_OPERATOR_URL")
if [ -n "${NERD_WORKSPACE:-}" ]; then
  ws=${NERD_WORKSPACE/#\~/$HOME}
  run mkdir -p "$ws"
  # Docker Desktop (macOS) maps file owners itself; on Linux uid 1000 must own it.
  owner=$(stat -c %u "$ws" 2>/dev/null || echo "?")
  [ "$owner" = 1000 ] || [ "$(uname -s)" = Darwin ] || say "warning: $ws is owned by uid $owner; the agent (uid 1000) must be able to write it (sudo chown 1000:1000 '$ws')"
  args+=(-v "$ws:/workspace")
else
  args+=(-v "$NERD_NAME-ws:/workspace")
fi
if [ -z "${NERD_NETWORK:-}" ]; then
  for p in "$NERD_SSH_PORT" "$NERD_APP_PORT"; do
    if nerd_port_busy "$p"; then die "port $p is in use on this host: choose another in .env"; fi
    args+=(-p "$NERD_BIND:$p:$p")
  done
fi
if [ -n "${NERD_DOCKER_ARGS:-}" ]; then
  read -r -a extra <<< "$NERD_DOCKER_ARGS"
  args+=("${extra[@]}")
fi
say "starting the agent $NERD_NAME from $NERD_IMAGE (server: $NERD_LLAMA_URL)"
run docker run "${args[@]}" "$NERD_IMAGE" tui >/dev/null

host=$(nerd_host_name)
connect() {
  echo
  echo "Connect:"
  if [ -n "${NERD_NETWORK:-}" ]; then
    echo "  ssh -p $NERD_SSH_PORT nerd@<address of $NERD_NETWORK>"
  elif [ "$NERD_BIND" = 127.0.0.1 ]; then
    echo "  ssh -p $NERD_SSH_PORT nerd@localhost        (ports bound to 127.0.0.1: this machine only)"
  else
    echo "  ssh -p $NERD_SSH_PORT nerd@$host        (from this machine: nerd@localhost)"
  fi
  echo "  log in with the private key that matches $keys; detach with Ctrl-b d"
  if [ -n "${NERD_OPERATOR_URL:-}" ]; then
    echo "  what the agent builds: $NERD_OPERATOR_URL"
  else
    [ "$NERD_BIND" = 127.0.0.1 ] && host=localhost
    echo "  what the agent builds: http://$host:$NERD_APP_PORT  (set NERD_OPERATOR_URL so the agent names it too)"
  fi
  if [ "$NERD_LLAMA" = host ]; then
    echo "  status: ./STATUS    stop: ./DOWN    logs: docker logs -f $NERD_NAME"
    echo "  the model: tools/llama-host.sh status | stop | logs (not stopped by ./DOWN)"
  else
    echo "  status: ./STATUS    stop: ./DOWN    logs: docker logs -f $NERD_NAME (agent), $NERD_LLM_NAME (server)"
  fi
  return 0
}

[ "$dry" = 1 ] && { connect; exit 0; }
if [ "$wait" = 0 ]; then
  say "started; the model may still be downloading (./STATUS)"; connect; exit 0
fi

# Wait for "Pi in tmux session" in the agent's log: the server answers and the
# agent runs. The entrypoints' own lines ("[nerd hh:mm:ss] ...") of both are
# shown as they come; curl's progress meter (first start: 6-7 GB) once a minute.
say "waiting for the model and the agent (first start downloads 6-7 GB; Ctrl-C stops waiting, not the containers)"
watch=("$NERD_NAME"); [ "$NERD_LLAMA" = container ] && watch=("$NERD_LLM_NAME" "$NERD_NAME")
declare -A seen
tick=0
while :; do
  for c in "${watch[@]}"; do
    state=$(docker inspect -f '{{.State.Status}} {{.RestartCount}}' "$c" 2>/dev/null || echo "gone 0")
    if [ "${state%% *}" != running ] || [ "${state##* }" != 0 ]; then
      docker logs --tail 30 "$c" 2>&1 | tr '\r' '\n' | tail -30 | sed "s/^/  $c | /"
      die "$c stopped or restarted ($state); see the log above and docs/MAINTAIN.md#troubleshooting"
    fi
    logs=$(docker logs "$c" 2>&1 | tr '\r' '\n')
    lines=$(grep '^\[nerd ' <<< "$logs" || true)
    n=$(grep -c . <<< "$lines" || true)
    if [ "$n" -gt "${seen[$c]:-0}" ]; then tail -n "$((n - ${seen[$c]:-0}))" <<< "$lines" | sed "s/^/  $c | /"; seen[$c]=$n; fi
    if [ "$c" = "$NERD_LLM_NAME" ] && [ $((tick % 12)) = 11 ]; then
      progress=$(grep -v '^\[nerd ' <<< "$logs" | grep -E '^ *[0-9]+ ' | tail -1 || true)
      if [ -n "$progress" ]; then echo "  $c | curl: $progress"; fi
    fi
  done
  docker logs "$NERD_NAME" 2>&1 | grep -q "Pi in tmux session" && break
  tick=$((tick + 1))
  sleep 5
done
say "ready"
connect
