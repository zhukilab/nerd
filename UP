#!/usr/bin/env bash
# Start nerd: work out this machine and the settings, then let docker compose
# start the model server (container <name>-llm, or on this machine with
# NERD_LLAMA=host or mlx) and the agent (container <name>, tui mode), both with a
# restart policy; wait until the model is served and the agent is up; print
# how to connect. What runs is described in compose.yaml (decision 0012).
# Settings: .env (see env.example). Docs: docs/OPERATE.md.
#
#   ./UP              build if needed, start, wait for the model
#   ./UP --build      rebuild the images first (after git pull)
#   ./UP --no-wait    start and return; ./STATUS tells when it is ready
#   ./UP --dry-run    print the compose command and its resolved configuration, run nothing
#
# Compose replaces only a container whose image or settings changed, so ./UP
# after a change to the agent does not reload the model.
set -euo pipefail
# shellcheck source=tools/lib.sh
. "$(dirname "$0")/tools/lib.sh"

build=0 wait=1 dry=0
for a in "$@"; do
  case "$a" in
    --build) build=1 ;;
    --no-wait) wait=0 ;;
    --dry-run) dry=1 ;;
    -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
    *) echo "UP: unknown argument '$a' (--build, --no-wait, --dry-run)" >&2; exit 2 ;;
  esac
done

nerd_load_env
nerd_settings
[ "$dry" = 1 ] || { nerd_log up; trap nerd_log_path EXIT; }
say() { echo "[UP] $*"; }
die() { echo "[UP] ERROR: $*" >&2; exit 1; }
run() { if [ "$dry" = 1 ]; then { printf '+'; printf ' %q' "$@"; echo; } >&2; else "$@"; fi; }

command -v docker >/dev/null || die "docker not found: tools/install-prerequisites.sh"
docker info >/dev/null 2>&1 || die "docker is not usable by $(id -un) (daemon down, or not in group docker): tools/check-prerequisites.sh"
cver=$(docker compose version --short 2>/dev/null || true)
[ -n "$cver" ] || die "docker compose (v2) not found: tools/install-prerequisites.sh, or the docker-compose-plugin package"
nerd_ver_ge "${cver#v}" 2.24 || die "docker compose $cver is too old: 2.24 or newer is needed (tools/install-prerequisites.sh)"

for v in NERD_DOCKER_ARGS NERD_SERVER_DOCKER_ARGS; do
  [ -z "${!v:-}" ] || die "$v is gone (decision 0012): put the same into compose.override.yaml next to compose.yaml (docs/OPERATE.md, \"Your own additions\")"
done

keys=$(nerd_keys_file) || die "no ssh public key: set NERD_AUTHORIZED_KEYS_FILE in .env, or ssh-keygen -t ed25519"
[ -s "$keys" ] || die "public key file '$keys' is missing or empty"
grep -q '^\(ssh-\|ecdsa-\|sk-\)' "$keys" || die "'$keys' does not look like a public key (ssh-ed25519 ...)"

case "$NERD_MODEL_VARIANT" in q1|q2) ;; *) die "NERD_MODEL_VARIANT must be q1 or q2" ;; esac
case "$NERD_LLAMA" in container|host|mlx) ;; *) die "NERD_LLAMA must be auto, container, host or mlx" ;; esac
# shellcheck source=container/model.sh
. "$NERD_ROOT/container/model.sh"
if [ "$NERD_LLAMA" != mlx ]; then msg=$(nerd_model_select) || die "$msg"; fi
if [ "$NERD_LLAMA" = mlx ] && [ "$(uname -s)" != Darwin ] && [ "$dry" = 0 ]; then
  die "NERD_LLAMA=mlx runs on a Mac with Apple silicon only (MLX); elsewhere: container"
fi
# The agent refuses a malformed NERD_SAMPLING at its start; say so here first.
for kv in ${NERD_SAMPLING//,/ }; do
  [[ "$kv" =~ ^(temperature|top_p|top_k|min_p|presence_penalty|frequency_penalty|repetition_penalty)=-?[0-9.]+$ ]] \
    || die "NERD_SAMPLING: '$kv' is not <temperature|top_p|top_k|min_p|presence_penalty|frequency_penalty|repetition_penalty>=<number>"
done
nerd_compose_env

# The model server on the host (macOS: llama-server, or mlx-vlm's with
# NERD_LLAMA=mlx): ./UP starts it, as compose starts the server container
# elsewhere, and ./DOWN stops it. One running with the settings of .env is
# kept, one with other settings restarted (tools/llama-host.sh start,
# tools/mlx-host.sh start). It must answer before the agent starts.
if nerd_on_host; then
  run "$(nerd_host_tool)" start \
    || die "the model server on this machine did not start (above; docs/MACOS.md, troubleshooting)"
fi

if [ "$dry" = 1 ]; then
  say "would run, with the variables of .env and these files:"
  { printf '+ docker compose -p %q ' "$NERD_NAME"; nerd_compose_files | tr '\n' ' '; echo "up -d"; } >&2
  nerd_compose config
  exit 0
fi

# --- images ----------------------------------------------------------------------
services=(agent); [ "$NERD_LLAMA" = container ] && services+=(llm)
for s in "${services[@]}"; do
  if [ "$s" = agent ]; then img=$NERD_IMAGE; what="the agent image $NERD_IMAGE ($(uname -m)); first build: 5-10 min"
  else img=$NERD_SERVER_IMAGE; what="the server image $NERD_SERVER_IMAGE (CUDA_ARCH=$NERD_CUDA_ARCH, CUDA_VERSION=$NERD_CUDA_VERSION); first build: 5-15 min plus the CUDA base image download"; fi
  if [ "$build" = 1 ] || ! docker image inspect "$img" >/dev/null 2>&1; then
    say "building $what"
    nerd_compose build "$s"
  fi
done

# --- network and volumes ------------------------------------------------------------
# Made here, not by compose, so they keep the names they had before compose and
# compose never removes them (./DOWN --purge does, when asked).
if [ -z "${NERD_NETWORK:-}" ]; then
  docker network inspect "$NERD_NAME-net" >/dev/null 2>&1 || docker network create "$NERD_NAME-net" >/dev/null
fi
for v in $(nerd_volumes) "$NERD_MODELS_VOLUME"; do
  docker volume inspect "$v" >/dev/null 2>&1 || { docker volume create "$v" >/dev/null; say "volume $v created"; }
done

# Containers of the same names that compose did not start (./UP before
# decision 0012 used docker run): replaced, their volumes stay.
for c in "$NERD_NAME" "$NERD_LLM_NAME"; do
  p=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$c" 2>/dev/null) || continue
  if [ "$p" != "$NERD_NAME" ]; then
    say "replacing the container $c made without compose (the volumes are kept)"
    docker rm -f "$c" >/dev/null
  fi
done

# A busy port is someone else's unless our own agent holds it.
if [ -z "${NERD_NETWORK:-}" ] && ! docker container inspect "$NERD_NAME" >/dev/null 2>&1; then
  for p in "$NERD_SSH_PORT" "$NERD_APP_PORT"; do
    if nerd_port_busy "$p"; then die "port $p is in use on this host: choose another in .env"; fi
  done
fi

if [ "$NERD_LLAMA" = container ]; then srv="$NERD_LLM_NAME, GPU $(nerd_gpu_mode)"; else srv="on this machine"; fi
say "starting (server: $srv; agent: $NERD_NAME, the server at $NERD_LLAMA_URL)"
nerd_compose up -d --no-build --pull never

host=$(nerd_host_name)
connect() {
  echo
  echo "Connect:"
  if [ -n "${NERD_NETWORK:-}" ]; then
    echo "  ssh -p $NERD_SSH_PORT nerd@<address of $NERD_NETWORK>"
  elif [ "$NERD_BIND" = 127.0.0.1 ]; then
    echo "  ssh -p $NERD_SSH_PORT nerd@localhost        (ports bound to 127.0.0.1: this machine only)"
  else
    echo "  ssh -p $NERD_SSH_PORT nerd@$host        (from this machine: nerd@localhost)"
  fi
  echo "  log in with the private key that matches $keys; detach with Ctrl-b d"
  if [ -n "${NERD_OPERATOR_URL:-}" ]; then
    echo "  what the agent builds: $NERD_OPERATOR_URL"
  else
    [ "$NERD_BIND" = 127.0.0.1 ] && host=localhost
    echo "  what the agent builds: http://$host:$NERD_APP_PORT  (set NERD_OPERATOR_URL so the agent names it too)"
  fi
  if nerd_on_host; then
    echo "  status: ./STATUS    stop: ./DOWN    logs: docker logs -f $NERD_NAME"
    echo "  the model: tools/$(basename "$(nerd_host_tool)") status | logs (./DOWN stops it too, ./DOWN --agent keeps it)"
  else
    echo "  status: ./STATUS    stop: ./DOWN    logs: docker logs -f $NERD_NAME (agent), $NERD_LLM_NAME (server)"
  fi
  return 0
}

if [ "$wait" = 0 ]; then
  say "started; the model may still be downloading (./STATUS)"; connect; exit 0
fi

# Wait for "Pi in tmux session" in the agent's log: the server answers and the
# agent runs. The entrypoints' own lines ("[nerd hh:mm:ss] ...") of both are
# shown as they come; curl's progress meter (first start: 6-7 GB) once a minute.
say "waiting for the model and the agent (first start downloads 6-7 GB; Ctrl-C stops waiting, not the containers)"
watch=("$NERD_NAME"); [ "$NERD_LLAMA" = container ] && watch=("$NERD_LLM_NAME" "$NERD_NAME")
declare -A seen
tick=0
while :; do
  for c in "${watch[@]}"; do
    state=$(docker inspect -f '{{.State.Status}} {{.RestartCount}}' "$c" 2>/dev/null || echo "gone 0")
    if [ "${state%% *}" != running ] || [ "${state##* }" != 0 ]; then
      docker logs --tail 30 "$c" 2>&1 | tr '\r' '\n' | tail -30 | sed "s/^/  $c | /"
      die "$c stopped or restarted ($state); see the log above and docs/MAINTAIN.md#troubleshooting"
    fi
    logs=$(docker logs "$c" 2>&1 | tr '\r' '\n')
    lines=$(grep '^\[nerd ' <<< "$logs" || true)
    n=$(grep -c . <<< "$lines" || true)
    if [ "$n" -gt "${seen[$c]:-0}" ]; then tail -n "$((n - ${seen[$c]:-0}))" <<< "$lines" | sed "s/^/  $c | /"; seen[$c]=$n; fi
    if [ "$c" = "$NERD_LLM_NAME" ] && [ $((tick % 12)) = 11 ]; then
      progress=$(grep -v '^\[nerd ' <<< "$logs" | grep -E '^ *[0-9]+ ' | tail -1 || true)
      if [ -n "$progress" ]; then echo "  $c | curl: $progress"; fi
    fi
  done
  docker logs "$NERD_NAME" 2>&1 | grep -q "Pi in tmux session" && break
  tick=$((tick + 1))
  sleep 5
done
say "ready"
connect
